{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "Static frontend from frontend/, Flask backend as one Python function.",

  "framework": null,
  "outputDirectory": "frontend",

  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },

  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
