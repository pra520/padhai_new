padhai.db
padhai.db-wal
padhai.db-shm
studyai.db
studyai.db-wal
studyai.db-shm

# Secrets stay local; configure them as Environment Variables in Vercel.
.env

# Local tooling and build artefacts
__pycache__/
*.pyc
.venv/
venv/
.claude/
*.pdf

# Optional heavy dependency list, not installed on Vercel
backend/requirements-audio.txt
