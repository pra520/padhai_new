# ======================= Padhai configuration =======================
# Copy this file to .env and fill in your key. NEVER commit .env.

# --- OpenRouter (FREE models only) ---
# 1. Create a free account at https://openrouter.ai
# 2. Go to https://openrouter.ai/settings/keys and create a key
# 3. Paste it below. No billing needed — only ":free" models are used.
OPENROUTER_API_KEY=

# Free models tried in order (comma-separated, auto-fallback).
# The free roster changes over time — refresh from https://openrouter.ai/models?q=free
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,tencent/hy3:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- FREE AI providers (configure any one; more = better uptime) ---
# StudyAI tries them in this order and fails over automatically when one is
# rate-limited, times out or errors. A provider that recovers rejoins the
# rotation on its own — you never have to do anything.
#
#   1. Gemini  — https://aistudio.google.com/apikey   (best free limits)
#   2. OpenRouter — https://openrouter.ai/settings/keys
#   3. Groq    — https://console.groq.com/keys        (fastest responses)
#   4. Hugging Face — https://huggingface.co/settings/tokens
#
# With none of these set the app still works: summaries, key points and
# answers are built directly from your documents in offline mode.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# --- Google Programmable Search (real past papers) ---
# Gives real, ranked Google results for the "Search the web for papers"
# feature — 100 searches/day on the free tier, no billing needed.
#   1. API key:       https://developers.google.com/custom-search/v1/introduction
#                     (click "Get a Key", pick/create a project)
#   2. Search engine: https://programmablesearchengine.google.com/controlpanel/create
#                     turn ON "Search the entire web", then copy the
#                     "Search engine ID" (looks like a1b2c3d4e5f6g7h8i)
# Leave both blank to use the keyless DuckDuckGo fallback instead.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# auto (default) = Google when configured, DuckDuckGo as fallback.
# Force one engine with: google | ddg
# SEARCH_PROVIDER=auto

# --- Local Whisper speech-to-text (free, no key; optional install) ---
# WHISPER_MODEL=base

# --- Optional server settings ---
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0
# MAX_UPLOAD_MB=25
# DOC_TTL_HOURS=6

# --- Capacity limits ---
# All of these can be raised; none is a hard product restriction.
#   MAX_DOCS          documents per account. 0 = unlimited (default).
#   MAX_COMBINE_DOCS  how many may be studied together at once.
#   AI_CONTEXT_CHARS  characters of material sent to the AI per generated view.
#                     Larger = more complete summaries of big document sets,
#                     but slower, and a free model may reject a huge prompt.
#                     Material over this size is SAMPLED across every document
#                     rather than truncated, so no chapter is ever dropped.
#   MAX_UPLOAD_MB     maximum size of a single uploaded file.
#   MAX_NOTES         sticky notes per account.
MAX_DOCS=0
MAX_COMBINE_DOCS=60
AI_CONTEXT_CHARS=60000
MAX_UPLOAD_MB=100
MAX_NOTES=1000

# ---------------------------------------------------------------------------
# 5) Contact form email
#    Messages are ALWAYS saved to the database first, so nothing is ever lost.
#    Fill in ONE of the options below to also have them emailed to you.
#
#    Where messages go:
CONTACT_TO=
#
#    Option A - Resend (quickest: 100 emails/day free, no domain needed)
#      1. Sign up at https://resend.com
#      2. Create a key at https://resend.com/api-keys
#      3. Paste it below. Leave CONTACT_FROM as-is until you add a domain.
RESEND_API_KEY=
CONTACT_FROM=StudyAI <onboarding@resend.dev>
#
#    Option B - Brevo (300 emails/day free)
#      Key from https://app.brevo.com/settings/keys/api
#      Then set CONTACT_FROM to an address you have verified with Brevo.
BREVO_API_KEY=
#
#    Option C - Gmail (or any mailbox) over SMTP
#      Gmail needs an APP PASSWORD, not your normal password:
#      turn on 2-Step Verification, then create one at
#      https://myaccount.google.com/apppasswords  (16 characters)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Messages accepted from one IP address per hour
CONTACT_RATE_PER_HOUR=5
